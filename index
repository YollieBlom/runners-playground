<script>
{
/* ===== YOUR LINKS: paste your own addresses between the quotes ===== */
const LINKS = {
  runDiary:   "",  // Run Diary & Pace Matchmaker (GitHub Pages)
  mataffin:   "",  // Mataffin pace estimator
  kaapsehoop: "",  // Kaapsehoop pacing simulator
  signup:     "",  // Google Form for sign-ups / Pro waitlist
  clubs:      ""   // Google Form or WhatsApp link for clubs
};
document.querySelectorAll('[data-link]').forEach(a => {
  const url = LINKS[a.dataset.link];
  if (url) { a.href = url; a.target = '_blank'; a.rel = 'noopener'; }
  else a.addEventListener('click', e => { e.preventDefault(); a.textContent = 'Link coming soon'; });
});

/* menu */
const menuBtn = document.getElementById('menuBtn'), menu = document.getElementById('menu');
menuBtn.addEventListener('click', () => { const o = menu.classList.toggle('open'); menuBtn.setAttribute('aria-expanded', o); });
menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { menu.classList.remove('open'); menuBtn.setAttribute('aria-expanded', false); }));

/* helpers */
const $ = id => document.getElementById(id);
const num = id => { const v = parseFloat($(id).value); return isFinite(v) && v > 0 ? v : 0; };
const secs = p => num(p + '-h') * 3600 + num(p + '-m') * 60 + num(p + '-s');
const fmt = t => { t = Math.round(t); const h = Math.floor(t / 3600), m = Math.floor(t % 3600 / 60), s = t % 60; return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0'); };
const store = { get(k){ try { return JSON.parse(localStorage.getItem('trp-' + k)); } catch(e){ return null; } }, set(k, v){ try { localStorage.setItem('trp-' + k, JSON.stringify(v)); } catch(e){} } };
const DISTS = [[5,'5K'],[10,'10K'],[21.1,'Half'],[42.2,'Marathon']];

/* tabs */
const tabs = [...document.querySelectorAll('.tab')];
const showTab = t => { tabs.forEach(x => { const on = x === t; x.setAttribute('aria-selected', on); $(x.getAttribute('aria-controls')).hidden = !on; }); store.set('tab', t.id); };
tabs.forEach((t, i) => {
  t.addEventListener('click', () => showTab(t));
  t.addEventListener('keydown', e => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length]; n.focus(); showTab(n); } });
});
const savedTab = store.get('tab'); if (savedTab && $(savedTab)) showTab($(savedTab));

/* distance chips */
document.querySelectorAll('.chips').forEach(box => {
  const input = $(box.dataset.for);
  box.innerHTML = DISTS.map(([v, l]) => `<button type="button" class="chip" data-v="${v}">${l}</button>`).join('');
  const mark = () => box.querySelectorAll('.chip').forEach(c => c.classList.toggle('on', parseFloat(c.dataset.v) === parseFloat(input.value)));
  box.addEventListener('click', e => { const c = e.target.closest('.chip'); if (!c) return; input.value = c.dataset.v; input.dispatchEvent(new Event('input', { bubbles: true })); });
  input.addEventListener('input', mark); mark();
});

/* pace */
const pace = () => {
  const d = num('pace-d'), t = secs('pace');
  if (!d || !t) { $('pace-out').innerHTML = '– <small>/km</small>'; $('pace-kmh').textContent = '–'; $('pace-400').textContent = '–'; return; }
  const p = t / d;
  $('pace-out').innerHTML = fmt(p) + ' <small>/km</small>';
  $('pace-kmh').textContent = (3600 / p).toFixed(1) + ' km/h';
  $('pace-400').textContent = fmt(p * 0.4);
};
/* predictor */
const pred = () => {
  const d = num('pred-d'), t = secs('pred');
  $('pred-out').innerHTML = DISTS.map(([v, l]) => {
    const T = d && t ? t * Math.pow(v / d, 1.06) : 0;
    return `<div><b>${T ? fmt(T) : '–'}</b><span>${l}${T ? ' · ' + fmt(T / v) + '/km' : ''}</span></div>`;
  }).join('');
};
/* splits */
const split = () => {
  const d = num('sp-d'), t = secs('sp'), x = parseFloat($('sp-x').value) || 0;
  if (!d || !t) { $('sp-avg').innerHTML = '– <small>/km</small>'; $('sp-out').innerHTML = ''; return; }
  const avg = t / d, half = d / 2; let clock = 0, rows = '';
  for (let k = 1; k <= Math.ceil(d - 1e-9); k++) {
    const seg = Math.min(1, d - (k - 1));
    const mid = k - 1 + seg / 2;
    const p = avg * (mid < half ? 1 + x : 1 - x);
    clock += p * seg;
    rows += `<tr><td>${seg < 1 ? (k - 1 + seg).toFixed(1) : k}</td><td>${fmt(p)}</td><td>${fmt(clock)}</td></tr>`;
  }
  $('sp-avg').innerHTML = fmt(avg) + ' <small>/km</small>';
  $('sp-out').innerHTML = rows;
};

/* remember inputs */
const groups = { pace: ['pace-d','pace-h','pace-m','pace-s'], pred: ['pred-d','pred-h','pred-m','pred-s'], split: ['sp-d','sp-h','sp-m','sp-s','sp-x'] };
const runs = { pace, pred, split };
Object.entries(groups).forEach(([g, ids]) => {
  const saved = store.get(g);
  if (saved) ids.forEach((id, i) => { if (saved[i] != null) $(id).value = saved[i]; });
  ids.forEach(id => $(id).addEventListener('input', () => { runs[g](); store.set(g, ids.map(x => $(x).value)); }));
  ids.forEach(id => $(id).addEventListener('change', () => runs[g]()));
  runs[g]();
});
document.querySelectorAll('.chips').forEach(b => b.querySelectorAll('.chip').forEach(c => c.classList.toggle('on', parseFloat(c.dataset.v) === parseFloat($(b.dataset.for).value))));

/* challenges */
const CHALLENGES = [
  ['Monthly', 'var(--tq)', 'Distance Dash', 'Every km counts. Log your runs and see how far the community goes together this month.'],
  ['Weekly', 'var(--ye)', 'Hill Hustle', 'Find a hill and run it again. Most climbing metres this week wins the crown.'],
  ['Streak', 'var(--pk-l)', 'Seven Day Streak', 'Move every day for a week. Short runs count. Walks count. Showing up counts.']
];
$('challenge-list').innerHTML = CHALLENGES.map(([tag, c, name, txt]) => `
  <div class="card" style="display:flex;flex-direction:column;gap:14px">
   <span class="pill" style="align-self:flex-start;background:${c}">${tag}</span>
   <h3>${name}</h3>
   <p style="margin:0;flex-grow:1">${txt}</p>
   <a class="btn dark" data-ch href="#" style="align-self:flex-start">Join on Run Diary</a>
  </div>`).join('');
document.querySelectorAll('[data-ch]').forEach(a => { if (LINKS.runDiary) { a.href = LINKS.runDiary; a.target = '_blank'; a.rel = 'noopener'; } else a.addEventListener('click', e => { e.preventDefault(); a.textContent = 'Opening soon'; }); });

/* badges */
const BADGES = [
  ['First 5K', 'Finish your first 5K, any pace.', '#2EC4B6', 'M12 2l3 6 6 1-4.5 4 1 6.5L12 16l-5.5 3.5 1-6.5L3 9l6-1z'],
  ['Early Bird', 'Log five runs that start before 6am.', '#FFD23F', 'M12 3v2M5 12H3M21 12h-2M6 6l1.5 1.5M18 6l-1.5 1.5M8 16a4 4 0 0 1 8 0M3 20h18'],
  ['Hill Hero', 'Win a Hill Hustle week.', '#FF5C8A', 'M3 20 9 9l4 6 3-4 5 9z'],
  ['Streak Star', 'Complete the Seven Day Streak.', '#2EC4B6', 'M13 2 4 14h7l-1 8 9-12h-7z'],
  ['Half Hero', 'Finish a half marathon.', '#FFD23F', 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4'],
  ['Social Butterfly', 'Run with 10 different buddies from Pace Matchmaker.', '#FF5C8A', 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20a6 6 0 0 1 12 0M16 4a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 6']
];
$('badge-list').innerHTML = BADGES.map(([n, how, c, d], i) => `
  <button type="button" class="badge" data-i="${i}" aria-pressed="false">
   <span class="ring" style="background:${c}"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#0F2236" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg></span>
   <b>${n}</b>
  </button>`).join('');
$('badge-list').addEventListener('click', e => {
  const b = e.target.closest('.badge'); if (!b) return;
  document.querySelectorAll('.badge').forEach(x => x.setAttribute('aria-pressed', x === b));
  const [n, how] = BADGES[b.dataset.i];
  $('badge-info').textContent = n + ': ' + how;
});

/* plans */
const PLANS = [
  ['Beginner', 'var(--tq-l)', 'Couch to 5K', '8 weeks · 3 runs a week', ['Weeks 1–2: 1 min run / 2 min walk, x8','Weeks 3–4: 3 min run / 2 min walk, x5','Weeks 5–6: 5 min run / 1 min walk, x4','Week 7: run 10 min, walk 1, run 10 min','Week 8: run 25–30 min, then your first 5K!']],
  ['Level up', 'var(--ye-l)', '10K Builder', '8 weeks · 3–4 runs a week', ['One easy run, one long run, one quality run each week','Long run grows from 6 km to 11 km','Quality run: 6 x 2 min faster, 2 min easy','Every 4th week: cut back to recover','Race week: two short easy runs, rest the day before']],
  ['Race plan', 'var(--pk-l)', 'Kaapsehoop Half', '12 weeks · hill focus', ['Weekly hill repeats from week 3','Long run builds to 18 km with climbs','Practise walking the steepest bits on purpose','Use the pacing simulator to set your splits','Taper the last 2 weeks']],
  ['Race plan', 'var(--tq-l)', 'Mataffin Race', '8 weeks · pace focus', ['Set your goal with the Mataffin estimator','Tempo run each week at goal pace','Long run at easy pace, 1 min/km slower','Strides after two easy runs a week','Race week: keep legs fresh']]
];
$('plan-list').innerHTML = PLANS.map(([tag, bg, n, meta, weeks]) => `
  <details class="card" style="background:${bg}">
   <summary><span class="pill" style="align-self:flex-start;background:#fff;font-size:13px">${tag}</span><h3 style="font-size:28px">${n}</h3><span style="font-weight:700">${meta}</span><span class="more">See the plan →</span></summary>
   <div class="body"><ul class="weeks">${weeks.map(w => `<li>${w}</li>`).join('')}</ul></div>
  </details>`).join('');

/* tips */
const POSTS = [
  ['Pacing', '#2EC4B6', 'Why your easy runs should feel too easy', 'Easy runs build your engine without wrecking your legs. If you can chat in full sentences, you are at the right pace. Most runners go too fast on easy days and too slow on hard days. Slow down on easy days and your hard days get better.'],
  ['Race day', '#FFD23F', 'Your night-before race checklist', 'Lay out your kit, pin your number, charge your watch and set two alarms. Eat a familiar dinner, nothing new. Plan how you get to the start and arrive with 45 minutes to spare. Nothing new on race day: no new shoes, gels or breakfast.'],
  ['Hills', '#FF5C8A', 'Make friends with hills', 'Going up: shorten your stride, lean slightly from the ankles and drive your arms. Aim for even effort, not even pace. Going down: relax, let gravity help and keep your feet under you. Walking the steepest bits is smart, not cheating.']
];
$('post-list').innerHTML = POSTS.map(([cat, c, t, body]) => `
  <details class="card">
   <summary><div class="thumb" style="background:${c};margin:-26px -26px 10px" aria-hidden="true"><svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#0F2236" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="4" r="2"/><path d="M8 21l3-6 3 2 1 4M10 13l-2-2 4-4 3 3 3 1M6 12l2-2"/></svg></div><span class="eyebrow" style="margin:0;color:var(--pk-d)">${cat}</span><h3 style="font-size:24px">${t}</h3><span class="more">Read the tip →</span></summary>
   <div class="body"><p style="margin:0">${body}</p></div>
  </details>`).join('');
}
</script>
<script>
{
/* ===== RUN DIARY & HEAT ANALYZER ===== */
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val = id => { const v = parseFloat(String($(id).value).replace(',', '.')); return isFinite(v) ? v : NaN; };
const fmt = t => { t = Math.round(t); const h = Math.floor(t / 3600), m = Math.floor(t % 3600 / 60), s = t % 60; return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(s).padStart(2, '0'); };
const status = (msg, err) => { const s = $('h-status'); s.textContent = msg; s.classList.toggle('err', !!err); };
const pad = n => String(n).padStart(2, '0');
const localDate = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
$('h-date').value = localDate(new Date());

/* --- heat maths --- */
const dewPoint = (t, rh) => { const a = 17.62, b = 243.12, g = Math.log(rh / 100) + a * t / (b + t); return b * g / (a - g); };
const toF = c => c * 9 / 5 + 32;
const TABLE = [[100,0],[110,0.5],[120,1],[130,2],[140,3],[150,4.5],[160,6],[170,8],[180,10]];
const heatCost = sum => {
  if (sum <= 100) return 0;
  for (let i = 1; i < TABLE.length; i++) if (sum <= TABLE[i][0]) { const [x0,y0] = TABLE[i-1], [x1,y1] = TABLE[i]; return y0 + (y1 - y0) * (sum - x0) / (x1 - x0); }
  return Math.min(15, 10 + (sum - 180) * 0.2);
};
const verdict = sum => sum <= 100 ? 'Perfect running weather. No adjustment needed.'
  : sum <= 130 ? 'Warm. You might lose a little pace, nothing major.'
  : sum <= 150 ? 'Warm and sticky. Slower splits are normal: run by effort, not pace.'
  : sum <= 170 ? 'Steamy Lowveld special. Expect to be noticeably slower. Drink and ease off.'
  : 'Dangerous heat. Easy running only, or move it to the treadmill or a cooler time.';

let current = null;
const calc = () => {
  const d = val('h-d'), t = (val('h-h') || 0) * 3600 + (val('h-m') || 0) * 60 + (val('h-s') || 0), c = val('h-t'), rh = val('h-rh');
  if (!(d > 0) || !(t > 0) || !isFinite(c) || !(rh > 0 && rh <= 100)) { current = null; $('h-eff').innerHTML = '– <small>/km</small>'; $('h-verdict').textContent = 'Fill in distance, time, temperature and humidity.'; return; }
  const pace = t / d, dp = dewPoint(c, rh), sum = Math.round(toF(c) + toF(dp)), pct = heatCost(sum), eff = pace / (1 + pct / 100);
  $('h-eff').innerHTML = fmt(eff) + ' <small>/km</small>';
  $('h-pace').textContent = fmt(pace);
  $('h-pct').textContent = '+' + pct.toFixed(1) + '%';
  $('h-dew').textContent = Math.round(dp) + ' °C';
  $('h-sum').textContent = sum;
  $('h-verdict').textContent = verdict(sum);
  $('h-needle').style.left = Math.max(2, Math.min(98, (sum - 80) / (190 - 80) * 100)) + '%';
  $('h-meter-l').setAttribute('aria-label', 'Heat stress: ' + sum + ' on the temperature plus dew point scale');
  current = { date: $('h-date').value, time: $('h-time').value, km: +d.toFixed(2), secs: Math.round(t), temp: c, rh: Math.round(rh), sum, pct: +pct.toFixed(1), pace, eff };
};
['h-d','h-h','h-m','h-s','h-t','h-rh','h-date','h-time'].forEach(id => $(id).addEventListener('input', calc));
calc();

/* --- input source switch --- */
document.querySelectorAll('[data-src]').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('[data-src]').forEach(x => x.setAttribute('aria-pressed', x === b));
  $('drop-gpx').hidden = b.dataset.src !== 'gpx';
  $('drop-pic').hidden = b.dataset.src !== 'pic';
  status('');
}));

/* --- weather (Open-Meteo, free, no key) --- */
let gpxCoords = null;
const getCoords = () => new Promise((res, rej) => {
  if (gpxCoords) return res(gpxCoords);
  const v = $('h-loc').value;
  if (v !== 'gps') { const [a, b] = v.split(','); return res([+a, +b]); }
  if (!navigator.geolocation) return rej(new Error('Location is not available on this device.'));
  navigator.geolocation.getCurrentPosition(p => res([p.coords.latitude, p.coords.longitude]), () => rej(new Error('Location was blocked. Pick a town from the list instead.')), { timeout: 10000 });
});
$('h-loc').addEventListener('change', () => { gpxCoords = null; });
const fetchWeather = async () => {
  const date = $('h-date').value, time = $('h-time').value || '06:00';
  if (!date) { status('Pick a date first.', true); return; }
  status('Looking up the weather…');
  try {
    const [lat, lon] = await getCoords();
    const days = (Date.now() - new Date(date + 'T00:00').getTime()) / 864e5;
    if (days < -15) throw new Error('That date is too far in the future for a forecast.');
    const host = days > 80 ? 'https://archive-api.open-meteo.com/v1/archive' : 'https://api.open-meteo.com/v1/forecast';
    const url = `${host}?latitude=${lat.toFixed(3)}&longitude=${lon.toFixed(3)}&hourly=temperature_2m,relative_humidity_2m&timezone=auto&start_date=${date}&end_date=${date}`;
    const r = await fetch(url); if (!r.ok) throw new Error('The weather service did not answer.');
    const j = await r.json();
    const hr = Math.min(23, parseInt(time.split(':')[0], 10) || 0);
    const t = j.hourly?.temperature_2m?.[hr], rh = j.hourly?.relative_humidity_2m?.[hr];
    if (t == null || rh == null) throw new Error('No weather found for that hour.');
    $('h-t').value = Math.round(t * 10) / 10; $('h-rh').value = Math.round(rh);
    calc(); status(`Weather at ${pad(hr)}:00: ${t.toFixed(1)} °C and ${Math.round(rh)}% humidity.`);
  } catch (e) { status((e.message || 'Could not get the weather.') + ' You can type it in yourself.', true); }
};
$('h-wx').addEventListener('click', fetchWeather);

/* --- GPX upload --- */
const hav = (a, b) => { const R = 6371, r = Math.PI / 180, dLa = (b[0] - a[0]) * r, dLo = (b[1] - a[1]) * r; const h = Math.sin(dLa / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(dLo / 2) ** 2; return 2 * R * Math.asin(Math.sqrt(h)); };
$('gpx-file').addEventListener('change', async e => {
  const f = e.target.files[0]; if (!f) return;
  status('Reading your GPX file…');
  try {
    const xml = new DOMParser().parseFromString(await f.text(), 'application/xml');
    const pts = [...xml.getElementsByTagName('trkpt')].map(p => ({ ll: [+p.getAttribute('lat'), +p.getAttribute('lon')], t: p.getElementsByTagName('time')[0]?.textContent }));
    if (pts.length < 2) throw new Error('No track points found in that file.');
    let km = 0; for (let i = 1; i < pts.length; i++) km += hav(pts[i - 1].ll, pts[i].ll);
    const t0 = pts.find(p => p.t), t1 = [...pts].reverse().find(p => p.t);
    $('h-d').value = km.toFixed(2);
    if (t0 && t1) {
      const start = new Date(t0.t), secs = Math.round((new Date(t1.t) - start) / 1000);
      $('h-h').value = Math.floor(secs / 3600); $('h-m').value = Math.floor(secs % 3600 / 60); $('h-s').value = secs % 60;
      $('h-date').value = localDate(start); $('h-time').value = pad(start.getHours()) + ':' + pad(start.getMinutes());
    }
    gpxCoords = pts[0].ll;
    calc(); status(`Found ${km.toFixed(2)} km. Getting the weather for your start time…`);
    await fetchWeather();
  } catch (err) { status((err.message || 'Could not read that file.') + ' Try typing the run in instead.', true); }
});

/* --- screenshot upload (read on the device with Tesseract.js) --- */
let tessLoading = null;
const loadTess = () => tessLoading || (tessLoading = new Promise((res, rej) => { const s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js'; s.onload = () => res(window.Tesseract); s.onerror = () => rej(new Error('Could not load the screenshot reader.')); document.head.appendChild(s); }));
const toSecs = s => { const p = s.split(':').map(Number); return p.length === 3 ? p[0] * 3600 + p[1] * 60 + p[2] : p[0] * 60 + p[1]; };
const parseShot = text => {
  const t = text.replace(/,/g, '.').replace(/[’'′]/g, ':').replace(/″|"/g, '');
  const out = {};
  const dist = t.match(/(\d{1,3}(?:\.\d{1,2})?)\s*(?:km|kilomet)/i) || t.match(/distance\D{0,15}(\d{1,3}\.\d{1,2})/i);
  if (dist) out.km = parseFloat(dist[1]);
  const times = [...t.matchAll(/(\d{1,2}:\d{2}(?::\d{2})?)(\s*\/\s*km|\s*min\/km)?/gi)];
  const nonPace = times.filter(m => !m[2] && !/pace/i.test(t.slice(Math.max(0, m.index - 14), m.index)));
  const durations = nonPace.map(m => toSecs(m[1])).filter(s => s >= 300 && s < 86400);
  if (durations.length) out.secs = Math.max(...durations);
  const temp = t.match(/(-?\d{1,2}(?:\.\d)?)\s*°\s*C?/i) || t.match(/temp\D{0,12}(-?\d{1,2}(?:\.\d)?)/i);
  if (temp) out.temp = parseFloat(temp[1]);
  const hum = t.match(/humid\D{0,12}(\d{1,3})\s*%/i) || t.match(/(\d{1,3})\s*%\s*(?:humid|rh)/i);
  if (hum) out.rh = parseInt(hum[1], 10);
  const date = t.match(/(20\d{2})[-\/.](\d{1,2})[-\/.](\d{1,2})/) || null;
  if (date) out.date = `${date[1]}-${pad(date[2])}-${pad(date[3])}`;
  return out;
};
$('pic-file').addEventListener('change', async e => {
  const f = e.target.files[0]; if (!f) return;
  status('Reading your screenshot… this can take 10–20 seconds the first time.');
  try {
    const T = await loadTess();
    const { data } = await T.recognize(f, 'eng');
    const got = parseShot(data.text || '');
    const found = [];
    if (got.km) { $('h-d').value = got.km; found.push(got.km + ' km'); }
    if (got.secs) { $('h-h').value = Math.floor(got.secs / 3600); $('h-m').value = Math.floor(got.secs % 3600 / 60); $('h-s').value = got.secs % 60; found.push('time ' + fmt(got.secs)); }
    if (got.date) { $('h-date').value = got.date; found.push(got.date); }
    if (got.temp != null) { $('h-t').value = got.temp; found.push(got.temp + ' °C'); }
    if (got.rh) { $('h-rh').value = got.rh; found.push(got.rh + '% humidity'); }
    calc();
    if (!found.length) throw new Error('We couldn\'t find run details in that picture.');
    status('Found: ' + found.join(', ') + '. Please check the numbers below.' + (got.temp == null || !got.rh ? ' Tap the weather button to fill in the weather.' : ''));
  } catch (err) { status((err.message || 'Could not read that picture.') + ' Try a clearer screenshot, or type it in.', true); }
});

/* --- private diary: encrypted with your PIN, stored on this device --- */
const KEY = 'trp-diary-v1';
let cryptoKey = null, saltB = null, runs = [];
const b64 = u => btoa(String.fromCharCode(...new Uint8Array(u)));
const unb64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
const readStore = () => { try { return JSON.parse(localStorage.getItem(KEY)); } catch (e) { return null; } };
const derive = async (pin, salt) => { const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pin), 'PBKDF2', false, ['deriveKey']); return crypto.subtle.deriveKey({ name: 'PBKDF2', salt, iterations: 150000, hash: 'SHA-256' }, base, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']); };
const persist = async () => { const iv = crypto.getRandomValues(new Uint8Array(12)); const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, cryptoKey, new TextEncoder().encode(JSON.stringify(runs))); try { localStorage.setItem(KEY, JSON.stringify({ salt: b64(saltB), iv: b64(iv), data: b64(ct) })); } catch (e) { alertMsg('Could not save on this device.'); } };
const alertMsg = m => { $('d-err').textContent = m; };
const setLockedUI = () => {
  const has = !!readStore();
  $('d-msg').textContent = has ? 'Enter your PIN to open your diary.' : 'Choose a PIN to start your diary. Runs are saved on this device only, locked with your PIN.';
  $('d-go').textContent = has ? 'Open diary' : 'Create diary';
  $('d-reset').hidden = !has;
};
setLockedUI();
const openDiary = async () => {
  const pin = $('d-pin').value.trim();
  if (!/^\d{4,8}$/.test(pin)) { alertMsg('Use 4 to 8 numbers.'); return; }
  if (!window.crypto?.subtle) { alertMsg('This browser cannot lock the diary. Try Chrome or Safari.'); return; }
  const st = readStore();
  try {
    if (st) {
      saltB = unb64(st.salt); cryptoKey = await derive(pin, saltB);
      const pt = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: unb64(st.iv) }, cryptoKey, unb64(st.data));
      runs = JSON.parse(new TextDecoder().decode(pt));
    } else {
      saltB = crypto.getRandomValues(new Uint8Array(16)); cryptoKey = await derive(pin, saltB); runs = []; await persist();
    }
  } catch (e) { cryptoKey = null; alertMsg('Wrong PIN. Try again.'); return; }
  $('d-pin').value = ''; alertMsg('');
  $('d-locked').hidden = true; $('d-open').hidden = false; $('diary-tools').hidden = false;
  render();
};
$('d-go').addEventListener('click', openDiary);
$('d-pin').addEventListener('keydown', e => { if (e.key === 'Enter') openDiary(); });
$('d-lock').addEventListener('click', () => { cryptoKey = null; runs = []; $('d-open').hidden = true; $('diary-tools').hidden = true; $('d-locked').hidden = false; setLockedUI(); });
let resetArmed = false;
$('d-reset').addEventListener('click', () => {
  if (!resetArmed) { resetArmed = true; $('d-reset').textContent = 'Tap again to delete all saved runs and start over'; return; }
  try { localStorage.removeItem(KEY); } catch (e) {}
  resetArmed = false; $('d-reset').textContent = 'Forgot PIN? Start a new diary (deletes saved runs)'; setLockedUI(); alertMsg('Diary cleared. Choose a new PIN.');
});
$('h-save').addEventListener('click', async () => {
  calc();
  if (!current) { status('Fill in the run first.', true); return; }
  if (!cryptoKey) { status('Open your diary below first (enter your PIN), then tap save again.', true); $('diary-panel').scrollIntoView({ behavior: 'smooth' }); $('d-pin').focus({ preventScroll: true }); return; }
  runs.push({ ...current, id: Date.now() });
  runs.sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));
  await persist(); render(); status('Saved to your diary.');
});
$('d-rows').addEventListener('click', async e => {
  const b = e.target.closest('[data-del]'); if (!b) return;
  runs = runs.filter(r => String(r.id) !== b.dataset.del); await persist(); render();
});
$('d-csv').addEventListener('click', async () => {
  const csv = ['date,time,km,duration,pace_per_km,temp_c,humidity_pct,heat_cost_pct,effort_pace_per_km'].concat(runs.map(r => [r.date, r.time, r.km, fmt(r.secs), fmt(r.pace), r.temp, r.rh, r.pct, fmt(r.eff)].join(','))).join('\n');
  try { await navigator.clipboard.writeText(csv); $('d-csv').textContent = 'Copied!'; } catch (err) { $('d-csv').textContent = 'Copy not allowed here'; }
  setTimeout(() => { $('d-csv').textContent = 'Copy as CSV'; }, 2000);
});
const render = () => {
  $('d-empty').hidden = runs.length > 0;
  $('d-rows').innerHTML = [...runs].reverse().map(r => `<tr><td>${esc(r.date)}</td><td>${esc(r.km)}</td><td>${fmt(r.pace)}</td><td>${esc(r.temp)}°/${esc(r.rh)}%</td><td>+${esc(r.pct)}%</td><td><b>${fmt(r.eff)}</b></td><td><button type="button" data-del="${esc(r.id)}" aria-label="Delete run on ${esc(r.date)}">✕</button></td></tr>`).join('');
  draw();
};
const chartBox = $('d-chart'), svg = chartBox.querySelector('svg');
const draw = () => {
  const W = chartBox.clientWidth, H = chartBox.clientHeight;
  if (!W || $('d-open').hidden) return;
  if (runs.length < 2) { svg.innerHTML = `<text x="${W / 2}" y="${H / 2}" text-anchor="middle" font-family="Nunito" font-weight="700" font-size="15" fill="#3D4F63">Save two or more runs to see your trend.</text>`; return; }
  const L = 52, R = 14, T = 14, B = 30;
  const all = runs.flatMap(r => [r.pace, r.eff]); let lo = Math.min(...all), hi = Math.max(...all); const padv = Math.max(10, (hi - lo) * 0.12); lo -= padv; hi += padv;
  const x = i => L + (W - L - R) * (runs.length === 1 ? 0.5 : i / (runs.length - 1));
  const y = v => T + (H - T - B) * (v - lo) / (hi - lo); /* faster = higher */
  const line = (k, c) => `<polyline fill="none" stroke="${c}" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round" points="${runs.map((r, i) => x(i).toFixed(1) + ',' + y(r[k]).toFixed(1)).join(' ')}"/>` + runs.map((r, i) => `<circle cx="${x(i).toFixed(1)}" cy="${y(r[k]).toFixed(1)}" r="4.5" fill="#fff" stroke="${c}" stroke-width="2.5"/>`).join('');
  let grid = '';
  for (let g = 0; g <= 3; g++) { const v = lo + (hi - lo) * g / 3, yy = y(v); grid += `<line x1="${L}" x2="${W - R}" y1="${yy}" y2="${yy}" stroke="#E6FAF8" stroke-width="2"/><text x="${L - 8}" y="${yy + 5}" text-anchor="end" font-family="Nunito" font-size="13" font-weight="700" fill="#3D4F63">${fmt(v)}</text>`; }
  const first = runs[0].date.slice(5), last = runs[runs.length - 1].date.slice(5);
  const labels = W < 420 ? '' : `<text x="${L}" y="${H - 8}" font-family="Nunito" font-size="13" font-weight="700" fill="#3D4F63">${esc(first)}</text><text x="${W - R}" y="${H - 8}" text-anchor="end" font-family="Nunito" font-size="13" font-weight="700" fill="#3D4F63">${esc(last)}</text>`;
  svg.innerHTML = grid + labels + line('pace', '#FF5C8A') + line('eff', '#0B7A70');
};
const ro = new ResizeObserver(draw); ro.observe(chartBox);
}
</script>
</body>
</html>
