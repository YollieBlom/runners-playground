<main>
<section id="top" class="hero band">
 <div class="wrap">
  <div>
   <span class="pill" style="background:var(--ye)">Your running playground</span>
   <h1>Run. Play.<br><mark>Brag about it.</mark></h1>
   <p>Crunch your paces, take on community challenges, collect badges and follow a plan built for your next race. Running, but make it fun.</p>
   <div style="display:flex;flex-wrap:wrap;gap:14px">
    <a class="btn dark" href="#challenges">Start a challenge</a>
    <a class="btn" href="#calculators">Try the calculators</a>
   </div>
  </div>
  <div class="hero-art">
   <div class="blob" style="top:0;right:24px;width:110px;height:110px;border-radius:50%;background:var(--ye)"></div>
   <div class="blob" style="bottom:0;left:16px;width:76px;height:76px;border-radius:22px;background:var(--pk);transform:rotate(14deg)"></div>
   <div class="card challenge-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
     <span class="eyebrow" style="margin:0">Challenge of the month</span>
     <span class="pill" style="background:var(--ye);font-size:13px">LIVE</span>
    </div>
    <h3 style="font-size:32px">Distance Dash</h3>
    <p style="margin:6px 0 18px;font-size:16px;font-weight:600">Log every km this month and climb the leaderboard.</p>
    <div class="bar" role="img" aria-label="Community progress towards this month's goal"><i style="width:62%"></i></div>
    <p style="margin:14px 0 0;font-size:15px;font-weight:700;display:flex;align-items:center;gap:10px">
     <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#0F2236" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 14 7 22l5-3 5 3-1.5-8"/></svg>
     Finish to unlock the Dash Master badge
    </p>
   </div>
  </div>
 </div>
</section>

<section id="calculators" class="band">
 <div class="wrap">
  <div class="head-row">
   <div><span class="eyebrow">Calculators</span><h2>Do the maths,<br>then go run.</h2></div>
   <p class="lead" style="max-width:420px">Set your pace, predict your finish and plan race day, km by km. Your last numbers are remembered on this device.</p>
  </div>
  <div class="tabs" role="tablist" aria-label="Calculators">
   <button class="tab" role="tab" id="t-pace" aria-selected="true" aria-controls="p-pace">Pace</button>
   <button class="tab" role="tab" id="t-pred" aria-selected="false" aria-controls="p-pred">Finish predictor</button>
   <button class="tab" role="tab" id="t-split" aria-selected="false" aria-controls="p-split">Split sheet</button>
  </div>

  <div class="calc" id="p-pace" role="tabpanel" aria-labelledby="t-pace">
   <div class="calc-in">
    <h3 style="margin-bottom:14px">Pace calculator</h3>
    <div class="chips" data-for="pace-d"></div>
    <label class="field">Distance (km)<input id="pace-d" type="number" inputmode="decimal" min="0.1" step="0.1" value="5"></label>
    <div class="trio">
     <label class="field">Hours<input id="pace-h" type="number" inputmode="numeric" min="0" value="0"></label>
     <label class="field">Min<input id="pace-m" type="number" inputmode="numeric" min="0" max="59" value="30"></label>
     <label class="field">Sec<input id="pace-s" type="number" inputmode="numeric" min="0" max="59" value="0"></label>
    </div>
   </div>
   <div class="result" aria-live="polite">
    <span style="font-weight:700">Your pace</span>
    <div class="big" id="pace-out">6:00 <small>/km</small></div>
    <div class="sub">
     <div><b id="pace-kmh">10.0 km/h</b><span>Speed</span></div>
     <div><b id="pace-400">2:24</b><span>Per 400 m lap</span></div>
    </div>
   </div>
  </div>

  <div class="calc" id="p-pred" role="tabpanel" aria-labelledby="t-pred" hidden>
   <div class="calc-in">
    <h3 style="margin-bottom:6px">Finish time predictor</h3>
    <p style="margin:0 0 14px;font-size:15px;font-weight:600">Enter a recent race. We'll estimate the others.</p>
    <div class="chips" data-for="pred-d"></div>
    <label class="field">Race distance (km)<input id="pred-d" type="number" inputmode="decimal" min="0.1" step="0.1" value="5"></label>
    <div class="trio">
     <label class="field">Hours<input id="pred-h" type="number" inputmode="numeric" min="0" value="0"></label>
     <label class="field">Min<input id="pred-m" type="number" inputmode="numeric" min="0" max="59" value="28"></label>
     <label class="field">Sec<input id="pred-s" type="number" inputmode="numeric" min="0" max="59" value="0"></label>
    </div>
   </div>
   <div class="result" aria-live="polite">
    <span style="font-weight:700">Predicted finish times</span>
    <div class="sub" id="pred-out"></div>
    <p style="margin:16px 0 0;font-size:14px;color:#CFE3F2">Uses the Riegel formula. Predictions assume you've trained for the longer distance, and hills like Kaapsehoop will add time.</p>
   </div>
  </div>

  <div class="calc" id="p-split" role="tabpanel" aria-labelledby="t-split" hidden>
   <div class="calc-in">
    <h3 style="margin-bottom:14px">Split sheet</h3>
    <div class="chips" data-for="sp-d"></div>
    <label class="field">Distance (km)<input id="sp-d" type="number" inputmode="decimal" min="0.1" step="0.1" value="21.1"></label>
    <div class="trio">
     <label class="field">Hours<input id="sp-h" type="number" inputmode="numeric" min="0" value="2"></label>
     <label class="field">Min<input id="sp-m" type="number" inputmode="numeric" min="0" max="59" value="0"></label>
     <label class="field">Sec<input id="sp-s" type="number" inputmode="numeric" min="0" max="59" value="0"></label>
    </div>
    <label class="field">Strategy
     <select id="sp-x"><option value="0">Even pace</option><option value="0.02">Negative split (start 2% slower)</option></select>
    </label>
   </div>
   <div class="result" aria-live="polite">
    <span style="font-weight:700">Average pace</span>
    <div class="big" id="sp-avg">5:41 <small>/km</small></div>
    <div class="splits"><table><thead><tr><th>Km</th><th>Pace</th><th>Clock</th></tr></thead><tbody id="sp-out"></tbody></table></div>
   </div>
  </div>

  <div class="tools">
