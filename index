<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Runners Playground</title>
<meta name="description" content="Running calculators, community challenges, badges, training plans and tips. Run. Play. Brag about it.">
<meta name="theme-color" content="#2EC4B6">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
/* VOICE: playful, sporty, encouraging — a running club's toy box
   IDEA: a playground — chunky outlined pieces, sticker shadows, bright fields
   PICTURE: the live calculator result, big and yellow on navy
   COLOUR and TYPE: turquoise / yellow / pink fields, navy ink; Fredoka + Nunito
   LAYOUT: full-width colour bands, cards in auto-fit grids, one column on phones */
:root{--tq:#2EC4B6;--tq-l:#E6FAF8;--tq-d:#0B7A70;--ye:#FFD23F;--ye-l:#FFF6D1;--pk:#FF5C8A;--pk-l:#FFE3EC;--pk-d:#B0204F;--ink:#0F2236;--slate:#3D4F63;--line:3px solid var(--ink);color-scheme:light}
*{box-sizing:border-box;min-width:0}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:#fff;color:var(--ink);font:17px/1.55 'Nunito',system-ui,sans-serif;overflow-x:clip}
h1,h2,h3{font-family:'Fredoka',sans-serif;line-height:1.05;margin:0;text-wrap:balance}
h2{font-size:clamp(34px,5vw,54px)}
h3{font-size:26px}
a{color:var(--ink)}
.wrap{max-width:1240px;margin:0 auto;padding:clamp(56px,8vw,96px) clamp(18px,4vw,32px)}
.band{border-bottom:var(--line)}
.eyebrow{display:block;font-weight:800;font-size:15px;color:var(--tq-d);margin-bottom:8px}
.lead{font-size:18px;max-width:560px;margin:12px 0 0}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;border:var(--line);border-radius:999px;font:800 17px 'Nunito',sans-serif;text-decoration:none;color:var(--ink);background:#fff;box-shadow:4px 4px 0 var(--ink);cursor:pointer;transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}
.btn:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--pk);outline-offset:3px}
.btn.dark{background:var(--ink);color:#fff;box-shadow:4px 4px 0 var(--ye)}
.btn.pink{background:var(--pk)}
.card{background:#fff;border:var(--line);border-radius:26px;padding:26px;box-shadow:7px 7px 0 var(--ink)}
.grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
.pill{display:inline-block;padding:5px 14px;border:2px solid var(--ink);border-radius:999px;font-weight:800;font-size:14px}
.head-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:36px}
/* header */
header{position:sticky;top:0;z-index:10;background:#fff;border-bottom:var(--line)}
.nav{max-width:1240px;margin:0 auto;padding:12px clamp(18px,4vw,32px);display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;font:700 22px/1 'Fredoka',sans-serif}
.logo span span{color:#E0336B}
.menu{display:flex;align-items:center;gap:4px;font-weight:700}
.menu a{padding:10px 12px;border-radius:999px;text-decoration:none}
.menu a:hover{background:var(--tq-l)}
.menu-btn{display:none;width:48px;height:48px;border:var(--line);border-radius:14px;background:var(--ye);cursor:pointer}
@media(max-width:900px){
 .menu-btn{display:inline-flex;align-items:center;justify-content:center}
 .menu{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;align-items:stretch;background:#fff;border-bottom:var(--line);padding:12px 18px 20px}
 .menu.open{display:flex}
 .menu a{padding:14px 12px;font-size:18px}
 .menu .btn{margin-top:8px}
}
/* hero */
.hero{background:var(--tq)}
.hero .wrap{display:grid;gap:48px;align-items:center;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))}
.hero h1{font-size:clamp(46px,7vw,84px);margin:20px 0 18px}
.hero h1 mark{background:var(--pk);color:var(--ink);padding:0 12px;border:var(--line);border-radius:18px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
.hero p{font-size:20px;font-weight:600;max-width:540px;margin:0 0 28px}
.hero-art{position:relative;padding:28px 10px;display:flex;justify-content:center}
.blob{position:absolute;border:var(--line)}
.challenge-card{position:relative;width:100%;max-width:400px;transform:rotate(-2deg);box-shadow:10px 10px 0 var(--ink)}
.bar{height:22px;background:var(--tq-l);border:2px solid var(--ink);border-radius:999px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--pk);border-right:2px solid var(--ink)}
@media (prefers-reduced-motion:no-preference){.bar i{animation:grow 1.4s ease-out both}@keyframes grow{from{width:0}}}
/* calculators */
.tabs{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px}
.tab{min-height:48px;padding:10px 20px;border:var(--line);border-radius:999px;background:#fff;font:800 16px 'Nunito',sans-serif;color:var(--ink);cursor:pointer}
.tab[aria-selected=true]{background:var(--ink);color:#fff}
.calc{display:grid;gap:28px;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));align-items:start}
.calc-in{background:var(--ye);border:var(--line);border-radius:28px;padding:clamp(20px,3vw,32px);box-shadow:8px 8px 0 var(--ink)}
.field{display:block;font-weight:800;font-size:15px;margin-bottom:14px}
.field input,.field select{display:block;width:100%;margin-top:6px;padding:12px 14px;font:800 20px 'Nunito',sans-serif;color:var(--ink);background:#fff;border:var(--line);border-radius:16px}
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.chip{min-height:44px;padding:8px 16px;border:var(--line);border-radius:999px;background:#fff;font:800 15px 'Nunito',sans-serif;color:var(--ink);cursor:pointer}
.chip.on{background:var(--pk)}
.result{background:var(--ink);color:#fff;border-radius:28px;padding:clamp(22px,3vw,34px);border:var(--line)}
.big{font:700 clamp(48px,8vw,76px)/1 'Fredoka',sans-serif;color:var(--ye);white-space:nowrap}
.big small{font-size:22px;color:#fff}
.result .sub{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
.result .sub div{flex:1 1 130px;background:#1E3A55;border-radius:16px;padding:12px 14px}
.result .sub b{display:block;font:700 24px 'Fredoka',sans-serif;white-space:nowrap}
.result .sub span{font-size:14px;color:#CFE3F2}
.splits{max-height:340px;overflow:auto;margin-top:18px;border-radius:16px;background:#1E3A55}
.splits table{width:100%;border-collapse:collapse;font-size:15px}
.splits th,.splits td{padding:9px 14px;text-align:right;white-space:nowrap}
.splits th:first-child,.splits td:first-child{text-align:left}
.splits thead th{position:sticky;top:0;background:#2B4C6B}
.splits tr:nth-child(even) td{background:#22415F}
.tools{display:grid;gap:16px;margin-top:28px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.tool{display:flex;align-items:center;gap:16px;padding:18px;border:var(--line);border-radius:22px;text-decoration:none;font-weight:600}
.tool b{display:block;font-size:18px}
.ico{flex:none;width:52px;height:52px;border-radius:16px;border:var(--line);display:flex;align-items:center;justify-content:center}
/* badges */
.badges{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr))}
.badge{display:flex;flex-direction:column;align-items:center;gap:10px;background:none;border:0;padding:6px;font:inherit;color:var(--ink);cursor:pointer;text-align:center}
.badge .ring{width:110px;height:110px;border-radius:50%;border:4px solid var(--ink);display:flex;align-items:center;justify-content:center;box-shadow:5px 5px 0 var(--ink);transition:transform .15s}
.badge:hover .ring,.badge[aria-pressed=true] .ring{transform:rotate(-8deg) scale(1.05)}
.badge b{font:700 19px 'Fredoka',sans-serif}
.badge-info{margin-top:28px;min-height:60px;text-align:center;font-weight:700;font-size:18px}
/* plans + blog */
details.card{padding:0}
details.card summary{list-style:none;cursor:pointer;padding:26px;display:flex;flex-direction:column;gap:8px}
details.card summary::-webkit-details-marker{display:none}
details.card .more{font-weight:800}
details.card[open] .more{display:none}
details.card .body{padding:0 26px 26px}
.weeks{margin:0;padding-left:20px}
.weeks li{margin-bottom:6px}
.thumb{height:150px;border-bottom:var(--line);display:flex;align-items:center;justify-content:center;border-radius:23px 23px 0 0}
/* pricing */
.price{display:flex;flex-direction:column;gap:14px}
.price .amt{font:700 46px/1 'Fredoka',sans-serif;white-space:nowrap}
.price .amt small{font-size:18px}
.price ul{margin:0;padding-left:20px;flex-grow:1}
.price li{margin-bottom:8px}
/* footer */
footer{background:var(--ink);color:#fff}
footer a{color:#fff}
.join{background:var(--ye);color:var(--ink);border:3px solid #fff;border-radius:32px;padding:clamp(24px,5vw,48px);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:24px}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px;margin-top:48px;padding-top:24px;border-top:2px solid #2B4560;font-weight:700}
.foot nav{display:flex;flex-wrap:wrap;gap:20px}
.note{font-size:14px;color:var(--slate)}
/* run diary & heat analyzer */
.diary{background:var(--ink);color:#fff}
.diary .eyebrow{color:var(--tq)}
.diary .lead{color:#E4EEF6}
.heat{display:grid;gap:28px;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));align-items:start}
.panel{background:#fff;color:var(--ink);border:3px solid #fff;border-radius:28px;padding:clamp(20px,3vw,30px)}
.src{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:18px}
.src button{min-height:48px;border:var(--line);border-radius:16px;background:#fff;font:800 15px 'Nunito',sans-serif;color:var(--ink);cursor:pointer;padding:6px}
.src button[aria-pressed=true]{background:var(--tq)}
.drop{display:block;border:3px dashed var(--ink);border-radius:20px;padding:22px;text-align:center;font-weight:700;background:var(--tq-l);cursor:pointer;margin-bottom:14px}
.drop input{display:block;margin:10px auto 0;max-width:100%;font-size:15px}
.duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.status{min-height:24px;font-weight:700;font-size:15px;margin:4px 0 12px;color:var(--tq-d)}
.status.err{color:var(--pk-d)}
.mini{min-height:44px;padding:8px 16px;border:var(--line);border-radius:999px;background:var(--ye);font:800 15px 'Nunito',sans-serif;color:var(--ink);cursor:pointer}
.heat-out{background:var(--ye);color:var(--ink);border:3px solid #fff;border-radius:28px;padding:clamp(20px,3vw,30px)}
.heat-out .big{color:var(--ink)}
.heat-out .big small{color:var(--ink)}
.meter{height:20px;border:var(--line);border-radius:999px;background:linear-gradient(90deg,#2EC4B6,#FFD23F 45%,#FF5C8A 80%,#B0204F);position:relative;margin:18px 0 6px}
.meter i{position:absolute;top:-8px;width:6px;height:30px;background:var(--ink);border-radius:3px;transform:translateX(-50%)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:16px}
.facts div{background:#fff;border:2px solid var(--ink);border-radius:16px;padding:10px 12px}
.facts b{display:block;font:700 22px 'Fredoka',sans-serif;white-space:nowrap}
.facts span{font-size:14px;font-weight:700}
.log{margin-top:28px}
.log table{width:100%;border-collapse:collapse;font-size:15px}
.log th,.log td{padding:10px 8px;border-bottom:2px solid var(--tq-l);text-align:right;white-space:nowrap}
.log th:first-child,.log td:first-child{text-align:left}
.log td button{min-width:44px;min-height:36px;border:2px solid var(--ink);border-radius:10px;background:#fff;cursor:pointer}
.chart{position:relative;height:260px;margin:18px 0 8px}
.chart svg{position:absolute;inset:0;width:100%;height:100%}
.key{display:flex;flex-wrap:wrap;gap:16px;font-size:14px;font-weight:700}
.key i{display:inline-block;width:22px;height:4px;border-radius:2px;vertical-align:middle;margin-right:6px}
.pin{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
.pin .field{flex:1 1 160px;margin:0}
@media(max-width:600px){.log th:nth-child(4),.log td:nth-child(4){display:none}}
</style>
</head>
